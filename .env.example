# DhanaDrishti Configuration Template
# For local development, copy this file to .env.local

# Supabase Auth Configuration (Required for live production sign-in)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Backend API Gateway Base URL (Defaults to /api)
VITE_API_BASE_URL=

# Server-Side Gemini AI Configuration (Server only - never exposed to browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
